{
    "enabledMcpjsonServers": ["firecrawl"],
    "enableAllProjectMcpServers": true,
    "permissions": {
        "allow": [
            "Bash(npm run dev)",
            "Bash(npm run build)",
            "Bash(npm run preview)",
            "Bash(npm run tauri)",
            "Bash(npm run:*)",
            "Bash(npm install:*)",
            "Bash(npx tauri:*)",
            "Bash(cargo check:*)",
            "Bash(cargo build:*)",
            "Bash(cargo test:*)",
            "Bash(cargo fmt:*)",
            "Bash(cargo clippy:*)",
            "Bash(git status)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git branch:*)",
            "Bash(git add:*)",
            "Bash(git commit:*)",
            "Bash(git stash:*)",
            "Bash(git checkout:*)",
            "Bash(git switch:*)",
            "Bash(ls:*)",
            "PowerShell(Get-ChildItem:*)",
            "PowerShell(Get-Content:*)",
            "PowerShell(Select-Object:*)",
            "Read",
            "Write",
            "Edit",
            "Glob",
            "Grep"
        ],
        "deny": [
            "Bash(rm -rf *)",
            "Bash(git push:*)",
            "Bash(git reset --hard:*)",
            "Bash(curl *)",
            "Bash(wget *)",
            "PowerShell(Remove-Item -Recurse -Force:*)",
            "PowerShell(Remove-Item:*)",
            "PowerShell(Invoke-WebRequest:*)",
            "PowerShell(Invoke-RestMethod:*)",
            "PowerShell(Invoke-Expression:*)",
            "PowerShell(Set-ExecutionPolicy:*)",
            "PowerShell(Start-BitsTransfer:*)",
            "Read(./.env)",
            "Read(**/.env)",
            "Read(**/credentials*)",
            "Read(**/secrets*)"
        ]
    }
}
