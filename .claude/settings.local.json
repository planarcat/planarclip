{
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run preview)",
      "Bash(npm run tauri)",
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(npx tauri:*)",
      "Bash(cargo check:*)",
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(ls:*)",
      "PowerShell(Get-ChildItem:*)",
      "PowerShell(Get-Content:*)",
      "PowerShell(Select-Object:*)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "PowerShell(git commit --amend -m $msg)",
      "PowerShell($msg = \"fix: use dedicated runtime for Tauri setup background tasks`n`nReplace tokio::spawn with std::thread + dedicated Tokio runtime in setup hook, since no Tokio runtime exists at that point. Also add GitNexus code intelligence config to CLAUDE.md and skill files.\")"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "PowerShell(Remove-Item -Recurse -Force:*)",
      "PowerShell(Remove-Item:*)",
      "PowerShell(Invoke-WebRequest:*)",
      "PowerShell(Invoke-RestMethod:*)",
      "PowerShell(Invoke-Expression:*)",
      "PowerShell(Set-ExecutionPolicy:*)",
      "PowerShell(Start-BitsTransfer:*)",
      "Read(./.env)",
      "Read(**/.env)",
      "Read(**/credentials*)",
      "Read(**/secrets*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "firecrawl"
  ]
}
