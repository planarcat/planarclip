{
  "$schema": "https://raw.githubusercontent.com/nicehash/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "PlanarClip",
  "version": "0.1.0",
  "identifier": "com.planarclip.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm exec vp dev",
    "beforeBuildCommand": "pnpm exec vp build"
  },
  "app": {
    "windows": [
      {
        "title": "PlanarClip",
        "width": 380,
        "height": 520,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
