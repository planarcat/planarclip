{
  "name": "planarclip-workspace",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "pnpm --filter planarclip dev",
    "dev:web": "pnpm --filter planarclip dev:web",
    "build": "pnpm --filter planarclip build",
    "build:web": "pnpm --filter planarclip build:web",
    "check": "pnpm --filter planarclip check",
    "check:web": "pnpm --filter planarclip check:web",
    "check:watch": "pnpm --filter planarclip check:watch",
    "preview:web": "pnpm --filter planarclip preview:web",
    "tauri": "pnpm --filter planarclip tauri",
    "pull": "node scripts/workspace-git-pull.mjs planarclip --analyze",
    "pull:only": "node scripts/workspace-git-pull.mjs planarclip",
    "pull:open": "node scripts/workspace-git-pull.mjs planarclip --analyze",
    "analyze": "node scripts/gitnexus-analyze-repo.mjs --all",
    "analyze:planarclip": "node scripts/gitnexus-analyze-repo.mjs planarclip",
    "gitnexus:analyze": "node scripts/gitnexus-analyze-repo.mjs --all"
  }
}
